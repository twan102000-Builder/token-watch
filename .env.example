# ==============================================================================
# Token Watch Configuration (.env)
# 100% Free, Private, and Self-Contained Local Token Monitor & Optimizer
# ==============================================================================

# Pre-Shared API Key for Hub and Sidecar authentication across your home network
# Generate a random key: openssl rand -hex 16
TOKENWATCH_API_KEY=your_secure_local_pre_shared_key_here

# Central Hub Configuration
TOKENWATCH_HUB_HOST=127.0.0.1
TOKENWATCH_HUB_PORT=9000

# Home Assistant Local Integration (Optional)
# Webhook URL inside your home network:
TOKENWATCH_HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/tokenwatch_alert

# Sidecar Configuration (Deployed on each agent/node)
TOKENWATCH_NODE_ID=node_livingroom_pi
TOKENWATCH_SIDECAR_PORT=8080
TOKENWATCH_UPSTREAM_URL=http://localhost:11434/v1
TOKENWATCH_OPTIMIZE_TOOLS=true

# Embedded SQLite WAL Storage Paths (Optional)
# TOKENWATCH_DB_PATH=data/tokenwatch.db
# TOKENWATCH_SPOOL_DB_PATH=data/sidecar_spool.db

