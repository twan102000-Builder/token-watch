[Unit]
Description=Token Watch Central Hub Daemon
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/token-watch
EnvironmentFile=/opt/token-watch/.env
ExecStart=/opt/token-watch/.venv/bin/python -m tokenwatch.hub
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
